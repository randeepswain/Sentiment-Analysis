# Root .gitignore for AI Product Review Chatbot

# Python environment
.venv/
venv/
ENV/
env/
bin/
lib/
include/
pip-selfcheck.json

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Node dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production builds
frontend/build/
frontend/dist/

# Environments and Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
